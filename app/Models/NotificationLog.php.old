        if ($mailTemplate) {
            return $this->belongsTo(MailTemplate::class, 'template_id');
        }

        // Se non trova MailTemplate, prova con NotificationTemplate
        return $this->belongsTo(NotificationTemplate::class, 'template_id');
    }
